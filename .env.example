# ── Core ──────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-me-with-a-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────────
# Leave blank for SQLite (dev). Set for PostgreSQL (prod).
DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins the Next.js frontend may call from.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Cloudflare R2 (media storage) ─────────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sanish-media
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ── Email ─────────────────────────────────────────────────────────────────────
# In dev (config.settings.dev) emails are printed to the console, not actually
# sent — these only take effect in production (config.settings.prod).
# For Gmail: use an App Password (not your normal password), host smtp.gmail.com, port 587.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@sanishlaminate.com
# Comma-separated — who receives a notification on every new website inquiry.
ADMIN_NOTIFY_EMAILS=info@sanishlaminate.com,karyaweb2025@gmail.com
