# ── Copy to deploy/.env on the server and fill in. Never commit deploy/.env ──

# ── Django core ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.staging
SECRET_KEY=generate-a-50+char-random-string
ALLOWED_HOSTS=staging.sanishlaminate.com
CSRF_TRUSTED_ORIGINS=https://staging.sanishlaminate.com
CORS_ALLOWED_ORIGINS=https://staging.sanishlaminate.com

# ── Postgres (consumed by both the db service and Django) ──────────────────
POSTGRES_DB=sanish
POSTGRES_USER=sanish
POSTGRES_PASSWORD=generate-a-strong-password
DATABASE_URL=postgres://sanish:generate-a-strong-password@db:5432/sanish

# ── Media ─────────────────────────────────────────────────────────────────
MEDIA_ROOT=/app/media

# ── Email (optional now — can also be set later via /cms/ SEO > Site Settings)
# Leave EMAIL_HOST blank to print inquiry notifications to the container log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@sanishlaminate.com
ADMIN_NOTIFY_EMAILS=info@sanishlaminate.com

# ── Frontend build arg (also passed via compose) ──────────────────────────
NEXT_PUBLIC_API_URL=https://staging.sanishlaminate.com/api
